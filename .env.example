# Cloudflare Worker runtime variables. Use .dev.vars locally (gitignored).
# Missing DEMO_MODE is deliberately safe: demo by default, with no real payments/emails.
DEMO_MODE=true
# User approved NO fixed kilometre limit; 0 disables a radial cap. Poland only.
SERVICE_RADIUS_KM=0
# Real mode requires all the following. Never put credentials into NEXT_PUBLIC_*.
TOMTOM_API_KEY=
APP_URL=https://your-public-domain.example
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
# Use independent sandbox credentials for the payment integration test.
P24_SANDBOX=true
RESEND_API_KEY=
EMAIL_FROM=Personal Taxi <orders@your-verified-domain.example>
OPERATIONS_EMAIL=orders@your-domain.example
# Random secret >=32 characters for external scheduler POST /api/internal/email-retry.
CRON_SECRET=
